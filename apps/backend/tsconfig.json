{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "outDir": "./dist",
        "rootDir": "./src",
        "composite": true,
        "declaration": true,
        "types": [
            "node"
        ]
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "src/**/*.test.ts",
        "src/**/*.spec.ts"
    ],
    "references": [
        {
            "path": "../../packages/shared"
        },
        {
            "path": "../../packages/core"
        },
        {
            "path": "../../packages/database"
        }
    ]
}